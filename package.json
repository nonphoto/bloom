{
  "name": "@nonphoto/bloom",
  "description": "Reactive animation tools",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "author": "Jonas Luebbers <jonas@jonasluebbers.com> (https://www.jonasluebbers.com)",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./src/*": "./src/*"
  },
  "files": [
    "./dist/*",
    "./src/*"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prepare": "pnpm build",
    "build": "tsup ./src/index.ts --dts --format esm --clean",
    "release": "semantic-release",
    "dev": "vinxi dev"
  },
  "dependencies": {
    "@nonphoto/spring": "4.1.2",
    "@nonphoto/spring-vector": "3.1.4",
    "@okikio/animate": "2.3.1",
    "@okikio/emitter": "2.1.7",
    "@solid-primitives/map": "0.4.13",
    "@solid-primitives/mouse": "2.0.20",
    "@solid-primitives/raf": "2.2.0",
    "@solid-primitives/rootless": "1.4.5",
    "@solid-primitives/utils": "6.2.3",
    "@thi.ng/compose": "3.0.14",
    "@thi.ng/geom": "8.1.12",
    "@thi.ng/math": "5.11.11",
    "@thi.ng/matrices": "2.4.16",
    "@thi.ng/transducers": "9.2.6",
    "@thi.ng/vectors": "7.12.4",
    "csstype": "3.1.3",
    "solid-js": "^1.9.2",
    "voby": "^0.58.1"
  },
  "devDependencies": {
    "@kobalte/core": "^0.13.7",
    "@nonphoto/css": "1.0.4",
    "@solid-primitives/event-listener": "2.3.3",
    "@solid-primitives/resize-observer": "2.0.26",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.14.7",
    "@solidjs/start": "^1.0.8",
    "prettier": "3.3.3",
    "semantic-release": "24.1.2",
    "solid-icons": "^1.1.0",
    "tsup": "^8.3.0",
    "tsup-preset-solid": "^2.2.0",
    "typescript": "5.6.2",
    "vinxi": "^0.4.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
