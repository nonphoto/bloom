{
	"name": "chloranthy-monorepo",
	"description": "Primitives for animating between layouts",
	"version": "0.0.1",
	"license": "MIT",
	"author": "Jonas Luebbers",
	"contributors": [],
	"private": true,
	"scripts": {
		"dev": "pnpm run --parallel --filter=./packages/* dev",
		"build": "turbo run build --filter=./packages/*",
		"test": "turbo run test --filter=./packages/*",
		"typecheck": "turbo run typecheck --filter=./packages/*",
		"build-test": "turbo run build test typecheck --filter=./packages/*",
		"format": "prettier --ignore-path .gitignore -w \"packages/**/*.{js,ts,json,css,tsx,jsx,md}\" \"web/**/*.{js,ts,json,css,tsx,jsx,md}\"",
		"docs": "turbo run docs && typedoc",
		"changeset": "changeset",
		"version-packages": "changeset version && pnpm i",
		"ci:version": "changeset version && pnpm i --no-frozen-lockfile && git add .",
		"release": "pnpm build && changeset publish",
		"update-deps": "pnpm up -Lri"
	},
	"devDependencies": {
		"@changesets/cli": "^2.26.2",
		"@chloranthy/core": "workspace:*",
		"@chloranthy/solid": "workspace:*",
		"@types/node": "^20.10.0",
		"concurrently": "^8.2.2",
		"jsdom": "^24.1.0",
		"prettier": "3.3.2",
		"tsup": "^8.1.0",
		"tsup-preset-solid": "^2.2.0",
		"turbo": "^2.0.6",
		"typedoc": "0.26.3",
		"typescript": "5.5.3",
		"vite": "^5.3.3",
		"vite-plugin-solid": "^2.10.2",
		"vitest": "^1.6.0"
	},
	"packageManager": "pnpm@9.4.0+sha512.f549b8a52c9d2b8536762f99c0722205efc5af913e77835dbccc3b0b0b2ca9e7dc8022b78062c17291c48e88749c70ce88eb5a74f1fa8c4bf5e18bb46c8bd83a",
	"engines": {
		"node": ">=17.0.0"
	}
}
