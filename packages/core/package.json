{
  "name": "@chloranthy/core",
  "version": "0.0.1",
  "description": "",
  "license": "MIT",
  "author": "Jonas Luebbers",
  "contributors": [],
  "homepage": "https://github.com/nonphoto/chloranthy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nonphoto/chloranthy.git"
  },
  "bugs": {
    "url": "https://github.com/nonphoto/chloranthy/issues"
  },
  "keywords": [
    "solid"
  ],
  "private": true,
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./body1d": {
      "types": "./dist/body1d.d.ts",
      "default": "./dist/body1d.js"
    },
    "./body2d": {
      "types": "./dist/body2d.d.ts",
      "default": "./dist/body2d.js"
    },
    "./quad2d": {
      "types": "./dist/quad2d.d.ts",
      "default": "./dist/quad2d.js"
    },
    "./rect": {
      "types": "./dist/rect.d.ts",
      "default": "./dist/rect.js"
    }
  },
  "browser": {},
  "typesVersions": {},
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "docs": "typedoc src/index.ts",
    "test": "concurrently pnpm:test:*",
    "test:client": "vitest -c ../../configs/vitest.config.ts",
    "test:ssr": "pnpm run test:client --mode ssr",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chloranthy/gl-matrix": "workspace:*",
    "@nonphoto/spring": "0.0.5"
  },
  "devDependencies": {
    "typedoc": "0.25.0"
  }
}
