{
  "name": "chloranthy",
  "version": "0.2.0",
  "author": "Jonas Luebbers",
  "license": "MIT",
  "homepage": "https://github.com/nonphoto/chloranthy",
  "repository": {
    "type": "git",
    "url": "https://github.com/nonphoto/chloranthy"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./animation": {
      "types": "./dist/animation/index.d.ts",
      "import": "./dist/animation/index.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "import": "./dist/dom/index.js"
    },
    "./rect": {
      "types": "./dist/rect/index.d.ts",
      "import": "./dist/rect/index.js"
    },
    "./style": {
      "types": "./dist/style/index.d.ts",
      "import": "./dist/style/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/*/index.ts --format esm --dts",
    "dev": "npm run build --watch"
  },
  "devDependencies": {
    "tsup": "6.3.0",
    "typescript": "4.8.4"
  },
  "dependencies": {
    "gl-matrix": "3.4.3"
  }
}
