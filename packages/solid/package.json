{
  "name": "@chloranthy/solid",
  "version": "0.0.1",
  "description": "",
  "license": "MIT",
  "author": "Jonas Luebbers",
  "contributors": [],
  "homepage": "https://github.com/nonphoto/chloranthy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nonphoto/chloranthy.git"
  },
  "bugs": {
    "url": "https://github.com/nonphoto/chloranthy/issues"
  },
  "keywords": [
    "solid"
  ],
  "private": false,
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "solid": {
      "development": "./dist/dev.jsx",
      "import": "./dist/index.jsx"
    },
    "development": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/dev.js"
      },
      "require": "./dist/dev.cjs"
    },
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "require": "./dist/index.cjs"
  },
  "browser": {},
  "typesVersions": {},
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "docs": "typedoc src/index.ts",
    "test": "concurrently pnpm:test:*",
    "test:client": "vitest -c ../../configs/vitest.config.ts",
    "test:ssr": "pnpm run test:client --mode ssr",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typedoc": "0.24.8"
  },
  "peerDependencies": {
    "solid-js": "^1.7.8"
  },
  "dependencies": {
    "@chloranthy/core": "workspace:*",
    "@chloranthy/layout-model": "workspace:*",
    "@solid-primitives/mouse": "2.0.14",
    "@solid-primitives/raf": "2.1.10",
    "@solid-primitives/resize-observer": "2.0.15",
    "@solid-primitives/rootless": "1.3.2",
    "@solid-primitives/utils": "6.1.0",
    "gl-matrix": "3.4.3"
  }
}
