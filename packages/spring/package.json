{
  "name": "@chloranthy/spring",
  "version": "0.0.1",
  "description": "Example hello world package in the chloranthy repository.",
  "license": "MIT",
  "author": "Jonas Luebbers",
  "contributors": [],
  "homepage": "https://github.com/nonphoto/chloranthy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nonphoto/chloranthy.git"
  },
  "bugs": {
    "url": "https://github.com/nonphoto/chloranthy/issues"
  },
  "keywords": [
    "solid"
  ],
  "private": true,
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "development": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/dev.js"
      },
      "require": "./dist/dev.cjs"
    },
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "require": "./dist/index.cjs"
  },
  "browser": {},
  "typesVersions": {},
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "concurrently pnpm:test:*",
    "test:client": "vitest -c ../../configs/vitest.config.ts",
    "test:ssr": "pnpm run test:client --mode ssr",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solid-primitives/map": "0.4.3",
    "gl-matrix": "^3.4.3",
    "solid-js": "^1.7.3"
  }
}
