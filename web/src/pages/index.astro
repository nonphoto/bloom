<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vite App</title>
  </head>
  <body>
    <div class="scrollParent" style="--size: 80vmin">
      <div class="scrollChild">
        <div class="scrollParent" style="--size: 60vmin">
          <div class="scrollChild">
            <div id="target" style="--size: 40vmin"></div>
          </div>
        </div>
      </div>
    </div>
    <script>
			import { RectObserver } from "@nonphoto-animate/rect-observer";

			const rectObserver = new RectObserver();

			console.log(rectObserver)

			const scrollParents = Array.from(document.querySelectorAll(".scrollParents"));

			for (const element of scrollParents) {
				rectObserver.observeScrollingElement(element);
			}
		</script>
  </body>
</html>

<style>
	* {
  box-sizing: border-box;
}

html,
body,
#root {
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  -webkit-touch-callout: none;
  -webkit-user-select: none;
  -khtml-user-select: none;
  -moz-user-select: none;
  -ms-user-select: none;
  user-select: none;
  overflow: hidden;
}

#root {
  overflow: auto;
}

html {
  font-family: system-ui;
}

body {
  position: fixed;
  overflow: hidden;
  overscroll-behavior-y: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.scrollParent {
  width: var(--size);
  height: var(--size);
  background-color: rgba(0, 0, 0, 0.1);
  overflow: auto;
  border-radius: 1rem;
}

.scrollChild {
  width: 200%;
  height: 200%;
  display: flex;
  justify-content: center;
  align-items: center;
}

#target {
  width: var(--size);
  height: var(--size);
  background-color: aquamarine;
  border-radius: 1rem;
}

</style>
