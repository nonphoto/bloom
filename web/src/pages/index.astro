<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vite App</title>
  </head>
  <body>
    <div class="scroll-container">
      <div class="scroll">
        <div class="absolute">
          <div class="sticky">
            <div class="fixed"></div>
          </div>
        </div>
        <div class="spacer"></div>
      </div>
    </div>
    <script>
			import { RectObserver } from "@nonphoto-animate/rect-observer";

			const rectObserver = new RectObserver();

			console.log(rectObserver)

			const scrollParents = Array.from(document.querySelectorAll(".scrollParents"));

			for (const element of scrollParents) {
				rectObserver.observeScrollingElement(element);
			}
		</script>
  </body>
</html>

<style>
* {
  margin: 0;
}

html {
  width: 100%;
  height: 100%;
}

body {
  width: 200%;
  height: 200%;
  display: flex;
}

div {
  border-radius: 0.5rem;
}

.scroll-container {
  margin-top: 100px;
  margin-left: 100px;
}

.scroll {
  width: 400px;
  height: 400px;
  overflow: scroll;

  /* TOGGLE THIS */
  /* position: relative; */
}

.spacer {
  width: 200%;
  height: 200%;
  background: lightgray;
}

.absolute {
  position: absolute;
  top: 200px;
  left: 200px;
  width: 200px;
  height: 200px;
  background: gray;
}

.sticky {
  position: sticky;
  top: 50px;
  left: 50px;
  width: 100px;
  height: 100px;
  background: blue;
}

.fixed {
  position: fixed;
  top: 50px;
  left: 50px;
  width: 100px;
  height: 100px;
  background: yellow;
}
</style>
