{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "Node",
    "baseUrl": ".",
    "lib": ["DOM"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["node", "solid-js"],
    "paths": {
      "@components/*": ["src/components/*"]
    }
  }
}
