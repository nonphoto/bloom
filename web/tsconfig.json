{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "checkJs": true,
    "lib": ["DOM"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["solid-js"],
    "paths": {
      "@components/*": ["src/components/*"]
    }
  }
}
