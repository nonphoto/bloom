{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsxImportSource": "solid-js",
    "jsx": "preserve",
    "strict": true,
    "types": ["solid-start/env"],
    "baseUrl": "./",
    "paths": {
      "~/*": ["./src/*"]
    },
    "plugins": [
      { "name": "typescript-plugin-css-modules", "options": { "noUncheckedIndexAccess": true } }
    ]
  }
}
