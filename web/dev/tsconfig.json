{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsxImportSource": "solid-js",
    "jsx": "preserve",
    "types": ["solid-start/env", "vite/client", "node"],
    "baseUrl": "./",
    "paths": {
      "~/*": ["./src/*"]
    },
    "plugins": [{ "name": "typescript-plugin-css-modules" }]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
